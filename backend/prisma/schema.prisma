generator client {
    provider = "prisma-client"
    output = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}


model Contrato {
    id Int @id @default(autoincrement())
    fileName String
    type String
    filePath String
    createdAt DateTime
    updatedAt DateTime
    chunks Chunk[]
    analysis Analysis?
}

model Chunk {
    id Int @id @default(autoincrement())
    contractId Int 
    content String
    page Int
    createdAt DateTime
    contrato Contrato @relation(fields: [contractId], references: [id])
}

model Analysis {
    id Int @id @default(autoincrement())
    contractId Int @unique 
    resumo String 
    classification String
    createdAt DateTime
    contrato Contrato @relation(fields: [contractId], references: [id])
}