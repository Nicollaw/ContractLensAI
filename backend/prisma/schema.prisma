generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contrato {
  id        String    @id @default(uuid()) @db.Uuid
  fileName  String
  type      String
  filePath  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chunks    Chunk[]
  analysis  Analysis?
}

model Chunk {
  id         Int      @id @default(autoincrement())
  contractId String   @db.Uuid
  content    String
  page       Int
  createdAt  DateTime @default(now())
  contrato   Contrato @relation(fields: [contractId], references: [id])
}

model Analysis {
  id             Int      @id @default(autoincrement())
  contractId     String   @unique @db.Uuid
  resumo         String
  classification String
  createdAt      DateTime @default(now())
  contrato       Contrato @relation(fields: [contractId], references: [id])
}
